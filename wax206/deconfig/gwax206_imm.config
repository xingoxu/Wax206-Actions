# ==================== 1. 设备基础与启动关键 (核心修复) ====================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7622=y
CONFIG_TARGET_mediatek_mt7622_DEVICE_netgear_wax206=y

# ==================== 编译优化（CCACHE 缓存） ====================
CONFIG_CCACHE=y

# 第三方 feed 仅参与固件编译，不写入 APK 在线软件源
# CONFIG_FEED_kenzok is not set
# CONFIG_FEED_passwall is not set
# CONFIG_FEED_openwrt_bandix is not set
# CONFIG_FEED_luci_app_bandix is not set

# ==================== luci-app-ddns-go 动态域名解析 ====================
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_luci-app-ddns-go=y

# ==================== 基础系统 ====================
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_px5g-mbedtls=y

# 核心稳定性补丁：防止循环重启
CONFIG_KERNEL_NVMEM=y
CONFIG_KERNEL_NVMEM_SYSFS=y
CONFIG_KERNEL_NVMEM_LAYOUT_FIXED=y
CONFIG_KERNEL_MTD_SPI_NAND_BMT=y
CONFIG_KERNEL_NET_RANDOM_ETHADDR=y
CONFIG_KERNEL_SMP=y

# 存储分区优化
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
CONFIG_TARGET_ROOTFS_PARTSIZE=448

# ==================== 2. MediaTek 硬件加速 (HNAT) ====================

CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-mt7530=y

# ==================== 3. 性能与内存优化 (建议项) ====================
# A53 调频插件
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y

# 内存压力缓解 (ZRAM)
CONFIG_KERNEL_SWAP=y
CONFIG_KERNEL_ZRAM=y
CONFIG_PACKAGE_zram-swap=y

# 系统统计与监控
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_luci-i18n-statistics-zh-cn=y

# ==================== 4. 无线驱动与固件 (Wi-Fi 6) ====================
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7915-firmware=y
CONFIG_PACKAGE_kmod-mt76-connac=y
CONFIG_PACKAGE_kmod-mt76-core=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_wpad-mbedtls=y

# ==================== 5. ImmortalWrt 特色插件 ====================
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_coreutils-base64=y

# ==================== 6. 界面与工具箱 ====================
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-app-package-manager=y

# 实用系统工具
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_ethtool-full=y

# ==================== WireGuard ====================
CONFIG_PACKAGE_luci-proto-wireguard=y

# ==================== OpenSSH 支持（完整） ====================
# 注意：Dropbear 和 OpenSSH 可以共存，但需要配置端口
# Dropbear 默认端口 22，OpenSSH 需要改端口或禁用 Dropbear
# 这里保留 Dropbear 作为默认 SSH，OpenSSH 用于 SFTP 功能
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_openssh-client=y
CONFIG_PACKAGE_openssh-keygen=y
# 可选：如果需要完整的 OpenSSH 服务器（替代 Dropbear）
# CONFIG_PACKAGE_openssh-server=y

# ==================== 文件传输工具 ====================
# scp 需要 openssh-client，已在上面配置
# rz/sz 用于终端文件传输（zmodem 协议）
CONFIG_PACKAGE_lrzsz=y
# tar 用于打包解包
CONFIG_PACKAGE_tar=y
# zip 用于压缩
CONFIG_PACKAGE_zip=y
