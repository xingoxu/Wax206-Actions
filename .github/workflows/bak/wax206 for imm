name: WAX206 ImmortalWrt 云编译

on:
  workflow_dispatch:
    inputs:
      dev_type:
        description: '选择设备分区布局 (Dev)'
        required: true
        type: choice
        options:
          - 'wax206'        # 默认布局
          - 'fmwax206'      # 70M 布局
          - 'gwax206'       # 256M 布局
          - 'gwax206_imm'   # 256M 布局 (针对 ImmortalWrt)
        default: 'gwax206_imm'

jobs:
  build:
    runs-on: ubuntu-22.04

    steps:
      - name: 检出代码仓库
        uses: actions/checkout@v4

      - name: 准备环境变量
        run: |
          echo "BUILD_DATE=$(date +'%Y.%m.%d-%H%M')" >> $GITHUB_ENV
          echo "BUILD_DIR=openwrt" >> $GITHUB_ENV

      - name: 安装编译依赖环境
        run: |
          sudo apt update -y
          sudo apt install -y ack antlr3 asciidoc autoconf automake autopoint binutils bison build-essential \
            bzip2 ccache clang cmake cpio curl device-tree-compiler flex gawk gcc-multilib \
            g++-multilib gettext genisoimage git gperf haveged help2man intltool \
            libc6-dev-i386 libelf-dev libfuse-dev libglib2.0-dev libgmp3-dev libltdl-dev \
            libmpc-dev libmpfr-dev libncurses5-dev libncursesw5-dev libpython3-dev \
            libreadline-dev libssl-dev libtool llvm lrzsz libnsl-dev ninja-build p7zip \
            p7zip-full patch pkgconf python3 python3-pyelftools python3-setuptools \
            qemu-utils rsync scons squashfs-tools subversion swig texinfo uglifyjs \
            upx-ucl unzip vim wget xmlto xxd zlib1g-dev

      - name: 克隆 ImmortalWrt 源码
        run: git clone https://github.com/immortalwrt/immortalwrt.git ${{ env.BUILD_DIR }}

      - name: 更新并安装 Feeds 软件包源
        working-directory: ./${{ env.BUILD_DIR }}
        run: |
          ./scripts/feeds update -a
          ./scripts/feeds install -a

      - name: 替换自定义 DTS 和 MK 文件 (实现大分区支持)
        working-directory: ./${{ env.BUILD_DIR }}
        run: |
          # 定义源码内的目标路径
          DTS_DST="target/linux/mediatek/dts/mt7622-netgear-wax206.dts"
          MK_DST="target/linux/mediatek/image/mt7622.mk"
          
          DEV_TYPE="${{ inputs.dev_type }}"
          
          case "$DEV_TYPE" in
            "fmwax206")
              echo "=== 应用 70M 大分区配置 ==="
              [ -f "../dts/wax206-70m.dts" ] && cp -f "../dts/wax206-70m.dts" "$DTS_DST"
              [ -f "../mediatek/image/mt7622-70m.mk" ] && cp -f "../mediatek/image/mt7622-70m.mk" "$MK_DST"
              ;;
            "gwax206" | "gwax206_imm")
              echo "=== 应用 256M 大分区配置 ==="
              [ -f "../dts/wax206-256m.dts" ] && cp -f "../dts/wax206-256m.dts" "$DTS_DST"
              [ -f "../mediatek/image/mt7622-256m.mk" ] && cp -f "../mediatek/image/mt7622-256m.mk" "$MK_DST"
              ;;
            *)
              echo "=== 使用默认配置，跳过替换 ==="
              ;;
          esac

      - name: 执行自定义修改脚本 (diy-part2.sh)
        run: |
          if [ -f "./diy-part2.sh" ]; then
            chmod +x "./diy-part2.sh"
            bash "./diy-part2.sh" "${{ inputs.dev_type }}" "${{ env.BUILD_DIR }}"
          fi

      - name: 生成编译配置文件 (.config)
        working-directory: ./${{ env.BUILD_DIR }}
        run: |
          cat > .config << 'EOF'
          CONFIG_TARGET_mediatek=y
          CONFIG_TARGET_mediatek_mt7622=y
          CONFIG_TARGET_mediatek_mt7622_DEVICE_netgear_wax206=y
          
          # 核心启动补丁 (WAX206 必需)
          CONFIG_KERNEL_NVMEM=y
          CONFIG_KERNEL_NVMEM_SYSFS=y
          CONFIG_KERNEL_NVMEM_LAYOUT_FIXED=y
          CONFIG_KERNEL_MTD_SPI_NAND_BMT=y
          CONFIG_KERNEL_NET_RANDOM_ETHADDR=y
          CONFIG_KERNEL_SMP=y
          
          # 硬件加速与性能调优
          CONFIG_PACKAGE_kmod-mtk-hnat=y
          CONFIG_PACKAGE_kmod-nft-offload=y
          CONFIG_PACKAGE_luci-app-cpufreq=y
          CONFIG_PACKAGE_luci-app-statistics=y
          
          # 内存优化配置
          CONFIG_KERNEL_SWAP=y
          CONFIG_KERNEL_ZRAM=y
          CONFIG_PACKAGE_zram-swap=y

          # 基础界面与常用插件
          CONFIG_PACKAGE_luci=y
          CONFIG_PACKAGE_luci-theme-argon=y
          CONFIG_LUCI_LANG_zh_Hans=y
          EOF
          
          # 动态注入 RootFS 分区大小，确保与 DTS 定义同步
          if [[ "${{ inputs.dev_type }}" == *"gwax"* ]]; then
             echo "CONFIG_TARGET_ROOTFS_PARTSIZE=240" >> .config
          elif [[ "${{ inputs.dev_type }}" == "fmwax206" ]]; then
             echo "CONFIG_TARGET_ROOTFS_PARTSIZE=60" >> .config
          fi
          
          make defconfig

      - name: 开始下载依赖并执行编译
        working-directory: ./${{ env.BUILD_DIR }}
        run: |
          make download -j$(nproc)
          make -j$(nproc) V=s || make -j1 V=s

      - name: 收集编译产物 (固件与 Manifest)
        run: |
          mkdir -p ./firmware
          cp -f ./${{ env.BUILD_DIR }}/bin/targets/mediatek/mt7622/*.bin ./firmware/
          cp -f ./${{ env.BUILD_DIR }}/bin/targets/mediatek/mt7622/*.itb ./firmware/
          cp -f ./${{ env.BUILD_DIR }}/bin/targets/mediatek/mt7622/*.manifest ./firmware/
          # 提取内核版本用于简介
          echo "KVER=$(grep "LINUX_VERSION" ./${{ env.BUILD_DIR }}/include/kernel-* | head -n 1 | cut -d' ' -f3 || echo 'Unknown')" >> $GITHUB_ENV

      - name: 生成发布固件简介 (Release Body)
        run: |
          echo "云编译发布" > release_body.txt
          echo "型号: WAX206 (${{ inputs.dev_type }})" >> release_body.txt
          echo "内核版本: ${{ env.KVER }}" >> release_body.txt
          echo "默认后台: 192.168.1.1" >> release_body.txt
          echo "已集成插件列表：" >> release_body.txt
          grep -oP "luci-app(-[a-zA-Z0-9]{1,}){1,}" ./firmware/*.manifest 2>/dev/null | awk -F":" '{print $NF}' | sort -u | xargs -n5 printf "%-25s %-25s %-25s %-25s %-25s\n" >> release_body.txt

      - name: 清理不必要的文件 (保留固件与 Manifest)
        run: |
          rm -f ./firmware/mt7622-ram-1ddr-bl2.bin
          rm -f ./firmware/mt7622-ram-2ddr-bl2.bin

      - name: 创建 GitHub Release 发布固件
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ env.BUILD_DATE }}_WAX206_${{ inputs.dev_type }}
          files: |
            ./firmware/*.bin
            ./firmware/*.itb
            ./firmware/*.manifest
          body_path: ./release_body.txt
